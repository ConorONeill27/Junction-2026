# ==============================================================================
# WorldGit Spatial Hub — Environment Variables (All Optional!)
# Every integration has an automatic offline/local fallback so you can run
# immediately without any API keys. Add keys below to unlock live cloud APIs.
# ==============================================================================

# 1. Google DeepMind — Gemini 2.5 Flash (POV object detection & Ctrl+Z steps)
GEMINI_API_KEY=

# 2. OpenAI — GPT-4o-mini (Multi-model fallback & Codex challenge)
OPENAI_API_KEY=

# 3. ElevenLabs — Ultra-low-latency spatial voice whispers (eleven_turbo_v2_5)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# 4. Aiven — Managed PostgreSQL URL for persistent spatial memory & Friend's World
# Example: postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
AIVEN_DATABASE_URL=

# 5. Modal — Cloud L4 GPU Depth-Anything-V2 3D point-cloud endpoint
# Deployed from gpu_worker/reconstruct.py via `modal deploy gpu_worker/reconstruct.py`
MODAL_RECONSTRUCT_URL=
